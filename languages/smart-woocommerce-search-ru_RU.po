msgid "Visibility of Products with Variations"
msgstr "Видимость продуктов с вариациями"

#: templates/admin-tab-general.php:183
msgid "Parent product with variations"
msgstr "Родительский продукт с вариациями"

#: templates/admin-tab-general.php:184
msgid "Only parent product"
msgstr "Только родительский продукт"

#: templates/admin-tab-general.php:185
msgid "Only variations"
msgstr "Только вариации"

#: templates/admin-tab-general.php:192
msgid "Search Results Page"
msgstr "Страница результатов поиска"

#: templates/admin-tab-general.php:197
msgid "Disable Redirect to Product Page"
msgstr "Отключите перенаправление на страницу продукта"

#: templates/admin-tab-general.php:198
msgid "Prevent WooCommerce from automatically redirecting to a product page when there is only one search result."
msgstr "Запретите WooCommerce автоматически перенаправлять на страницу товара, когда есть только один результат поиска."

#: templates/admin-tab-general.php:204
msgid "Suppress Database Query Altering"
msgstr "Подавление изменения запросов к базе данных"

#: templates/admin-tab-general.php:205
msgid "Prevent the theme or plugins from modifying the database query on the search results page"
msgstr "Запретите теме или плагинам изменять запрос к базе данных на странице результатов поиска"

#: templates/admin-tab-general.php:211
msgid "Disable Smart Search Feature on the Search Results Page"
msgstr "Отключите функцию интеллектуального поиска на странице результатов поиска"

#: templates/admin-tab-general.php:212
msgid "Disable altering search results by Smart Search plugin on the search results page.<br>By default the plugin modified search results according to selected options"
msgstr "Отключите изменение результатов поиска плагином Smart Search на странице результатов поиска.<br>По умолчанию плагин изменяет результаты поиска в соответствии с выбранными параметрами"

#: templates/admin-tab-general.php:218
msgid "Disable WooCommerce Template on the Search Results Page"
msgstr "Отключите шаблон WooCommerce на странице результатов поиска"

#: templates/admin-tab-general.php:219
msgid "Displays the default search results template defined in the theme instead of WooCommerce template.<br>Useful if you want to display posts with products together"
msgstr "Отображает шаблон результатов поиска по умолчанию, заданный в теме, вместо шаблона WooCommerce.<br>Полезно, если Вы хотите отображать посты с товарами вместе"

#: templates/admin-tab-general.php:225
msgid "Highlight Search Terms on the Search Results Page"
msgstr "Выделите поисковые термины на странице результатов поиска"

#: templates/admin-tab-general.php:226
msgid "Highlight words that match a search query on the search results page. Works only if the Smart Search Feature is not disabled on the search results page"
msgstr "Выделяет слова, соответствующие поисковому запросу, на странице результатов поиска. Работает только в том случае, если функция интеллектуального поиска не отключена на странице результатов поиска"

#: templates/admin-tab-general.php:231
msgid "Advanced"
msgstr "Дополнительно"

#: templates/admin-tab-general.php:237
msgid "It may be helpful if you changed the base slug for WooCommerce products. The base slug is \"product\""
msgstr "Возможно, Вам будет полезно изменить базовый slug для продуктов WooCommerce. Базовым slug является \"product\""

